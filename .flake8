[flake8]
# Generated from provided flake8_rules.json (enabled=true checks only).
max-complexity = 10
exclude =
    .git,
    __pycache__,
    zip_build

# Enabled checks from your JSON.
# Excluded C901 which is a complexity check,
# it kept flagging the main functions locally but not in in the plugins repository.
select =
    E101,
    E711,
    E712,
    E713,
    E714,
    E721,
    E722,
    E731,
    E741,
    E742,
    E743,
    E901,
    E902,
    E999,
    W605,
    F402,
    F403,
    F404,
    F405,
    F811,
    F821,
    F822,
    F823,
    F831,
    F901
